diff --git a/yt_idv/shaders/header.inc.glsl b/yt_idv/shaders/header.inc.glsl
index 39b5db4..917769c 100644
--- a/yt_idv/shaders/header.inc.glsl
+++ b/yt_idv/shaders/header.inc.glsl
@@ -1,4 +1,6 @@
 #version 330 core
+// lets ray_tracing.frag.glsl promise depth_greater, keeping early depth tests
+#extension GL_ARB_conservative_depth : enable
 
 const float INFINITY = 1. / 0.;
 const float PI = 3.1415926535897932384626433832795;
diff --git a/yt_idv/shaders/max_intensity.frag.glsl b/yt_idv/shaders/max_intensity.frag.glsl
index a3be2fc..07c182d 100644
--- a/yt_idv/shaders/max_intensity.frag.glsl
+++ b/yt_idv/shaders/max_intensity.frag.glsl
@@ -24,3 +24,8 @@ bool ray_is_done(in vec4 curr_color)
     // every sample along the ray counts
     return false;
 }
+
+float fragment_depth(in bool ever_sampled, in float nearest_sample_depth, in vec4 curr_color)
+{
+    return ever_sampled ? nearest_sample_depth : gl_FragCoord.z;
+}

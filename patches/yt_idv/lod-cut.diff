@@ -0,0 +1,84 @@
+"""
+Walking a kd-tree saved as arrays (see ``BlockCollection._kd_tree``) in
+viewpoint order, optionally stopping at nodes that have coarse data.
+"""
+
+cimport cython
+cimport numpy as np
+
+import numpy as np
+
+
+@cython.boundscheck(False)
+@cython.wraparound(False)
+def viewpoint_order(
+    np.int64_t[::1] left,
+    np.int64_t[::1] right,
+    np.int64_t[::1] split_dim,
+    np.float64_t[::1] split_pos,
+    np.int64_t[::1] block,
+    viewpoint,
+    np.int64_t[::1] order,
+    bint nearest_first=False,
+    np.int64_t[::1] lod_block=None,
+    np.float64_t[:, ::1] lod_bounds=None,
+    double max_angle=0.0,
+):
+    """
+    Fill *order* with the tree's leaf blocks from furthest to nearest
+    *viewpoint* (nearest first if *nearest_first*) and return how many it
+    wrote.
+
+    Node 0 is the root; *left* and *right* hold each node's children (-1 at
+    leaves), *split_dim* and *split_pos* its split, and *block* each leaf's
+    block (-1 to skip it).
+
+    With *lod_block* (a block per node, -1 where there is none) and
+    *lod_bounds* (each node's box as lo_x, lo_y, lo_z, hi_x, hi_y, hi_z), the
+    walk stops at a node whose box diagonal is smaller than *max_angle* times
+    its distance from *viewpoint*, and writes that node's block in place of
+    its leaves. A box holding the viewpoint is never stopped at.
+    """
+    cdef np.float64_t[3] vp
+    cdef np.int64_t[::1] stack = np.empty(left.shape[0] + 1, dtype="int64")
+    cdef Py_ssize_t top = 1, n = 0
+    cdef np.int64_t i, first, second
+    cdef int k
+    cdef double lo, hi, d2, diag2
+    cdef double max_angle2 = max_angle * max_angle
+    cdef bint use_lod = max_angle > 0 and lod_block is not None and lod_bounds is not None
+    for k in range(3):
+        vp[k] = viewpoint[k]
+    stack[0] = 0
+    while top > 0:
+        top -= 1
+        i = stack[top]
+        if left[i] == -1:
+            if block[i] != -1:
+                order[n] = block[i]
+                n += 1
+            continue
+        if use_lod and lod_block[i] != -1:
+            d2 = 0.0
+            diag2 = 0.0
+            for k in range(3):
+                lo = lod_bounds[i, k]
+                hi = lod_bounds[i, k + 3]
+                diag2 += (hi - lo) * (hi - lo)
+                if vp[k] < lo:
+                    d2 += (lo - vp[k]) * (lo - vp[k])
+                elif vp[k] > hi:
+                    d2 += (vp[k] - hi) * (vp[k] - hi)
+            if d2 > 0 and diag2 < max_angle2 * d2:
+                order[n] = lod_block[i]
+                n += 1
+                continue
+        # pushed last is walked first: the far child, or the near one if nearest_first
+        if (vp[split_dim[i]] <= split_pos[i]) != nearest_first:
+            first, second = left[i], right[i]
+        else:
+            first, second = right[i], left[i]
+        stack[top] = first
+        stack[top + 1] = second
+        top += 2
+    return n

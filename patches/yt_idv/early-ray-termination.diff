diff --git a/yt_idv/shaders/transfer_function.frag.glsl b/yt_idv/shaders/transfer_function.frag.glsl
index 943cd9d..13e4a18 100644
--- a/yt_idv/shaders/transfer_function.frag.glsl
+++ b/yt_idv/shaders/transfer_function.frag.glsl
@@ -39,3 +39,9 @@ vec4 cleanup_phase(in vec4 curr_color, in vec3 dir, in float t0, in float t1)
   //            curr_color.a * length(p1-p0));
   return curr_color;
 }
+
+bool ray_is_done(in vec4 curr_color)
+{
+    // front to back: once this opaque, what's behind adds under 0.1% of itself
+    return curr_color.a >= 0.999;
+}

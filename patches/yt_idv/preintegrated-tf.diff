+def transfer_function_integral(tf_data):
+    """
+    The running integral of a transfer function over its [0, 1] coordinate,
+    at its texel centers, as (n, 1, 4) float32 like *tf_data*.
+
+    *tf_data* is read as the shader reads it: linear between texel centers,
+    constant beyond the end ones, and uint8 data scaled to [0, 1].
+    """
+    values = np.asarray(tf_data, dtype="f8")[:, 0, :]
+    if np.asarray(tf_data).dtype == np.uint8:
+        values = values / 255.0
+    n = values.shape[0]
+    steps = (values[1:] + values[:-1]) / (2 * n)
+    integral = values[0] * (0.5 / n) + np.concatenate(
+        [np.zeros((1, 4)), np.cumsum(steps, axis=0)]
+    )
+    return integral[:, None, :].astype("f4")

diff --git a/yt_idv/shaders/transfer_function.frag.glsl b/yt_idv/shaders/transfer_function.frag.glsl
index 943cd9d..2285ae4 100644
--- a/yt_idv/shaders/transfer_function.frag.glsl
+++ b/yt_idv/shaders/transfer_function.frag.glsl
@@ -1,3 +1,76 @@
+// pre-integration: the transfer-function coordinate at the end of the last
+// step, which is the front of the next
+float tf_prev_u = 0.0;
+bool tf_have_prev = false;
+
+// The transfer-function coordinate of the field at tex_pos; false where the
+// bitmap masks it or, with tf_log, the field isn't positive.
+bool tf_coordinate(vec3 tex_pos, out float u)
+{
+    u = 0.0;
+    if (!(texture(bitmap_tex, get_bitmap_texture_position(tex_pos)).r > 0.0)) return false;
+    float value = texture(data_tex, get_offset_texture_position(data_tex, tex_pos)).r;
+    float tm = tf_min;
+    float tp = tf_max;
+    if (tf_log > 0.5) {
+        if (value <= 0.0) return false;
+        value = log(value);
+        tm = log(tm);
+        tp = log(tp);
+    }
+    u = (value - tm) / (tp - tm);
+    return true;
+}
+
+// The transfer function's mean over a step whose coordinate runs linearly
+// from u_front to u_back; outside [0, 1] it is zero.
+vec4 tf_mean(float u_front, float u_back, out bool in_range)
+{
+    float a = clamp(u_front, 0.0, 1.0);
+    float b = clamp(u_back, 0.0, 1.0);
+    float span = abs(u_back - u_front);
+    float inside = span > 1e-6 ? abs(b - a) / span : float(u_back >= 0.0 && u_back <= 1.0);
+    in_range = inside > 0.0;
+    if (!in_range) return vec4(0.0);
+    // within a texel the function is linear, so its mean is its midpoint value
+    if (abs(b - a) * float(textureSize(tf_tex, 0).x) < 1.0)
+        return texture(tf_tex, vec2(0.5 * (a + b), 0.5)) * inside;
+    vec4 integral = texture(tf_integral_tex, vec2(b, 0.5))
+                  - texture(tf_integral_tex, vec2(a, 0.5));
+    // float32 differences can dip just below zero where the function is ~0
+    return max(integral / (b - a), 0.0) * inside;
+}
+
+// The step [t, t + tdelta] around tex_curr_pos, integrated between the field
+// at its two ends. The texture is vertex centered, so a block's first step
+// starts on its boundary texels.
+bool sample_preintegrated(vec3 tex_curr_pos, out vec4 tf_sample, float tdelta, vec3 dir)
+{
+    tf_sample = vec4(0.0);
+    #ifdef NONCARTESIAN_GEOM
+    vec3 half_step = vec3(0.0);
+    #else
+    vec3 half_step = 0.5 * tdelta * dir / ((right_edge + dx / 2.0) - (left_edge - dx / 2.0));
+    #endif
+    float u_back;
+    if (!tf_coordinate(tex_curr_pos + half_step, u_back)) {
+        tf_have_prev = false;
+        return false;
+    }
+    float u_front = u_back;
+    if (tf_have_prev) {
+        u_front = tf_prev_u;
+    } else {
+        float u_entry;
+        if (tf_coordinate(tex_curr_pos - half_step, u_entry)) u_front = u_entry;
+    }
+    tf_prev_u = u_back;
+    tf_have_prev = true;
+    bool in_range;
+    tf_sample = tf_mean(u_front, u_back, in_range);
+    return in_range;
+}

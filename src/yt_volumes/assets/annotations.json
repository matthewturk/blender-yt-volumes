[
 {
  "name": "yt Annotation",
  "scene": "ANNOTATION",
  "description": "A starting point for your own: a dot at the volume's zoom target or middle, with its own node tree to edit",
  "inputs": {
   "Geometry": "NodeSocketGeometry",
   "Units Object": "NodeSocketObject",
   "Unit": "NodeSocketString",
   "Size": "NodeSocketFloat",
   "Color": "NodeSocketColor"
  }
 },
 {
  "name": "yt Colorbar",
  "scene": "ANNOTATION",
  "description": "A colorbar of the volume's transfer function: its colors, log10 ticks and labels, a title, and its opacity",
  "inputs": {
   "Geometry": "NodeSocketGeometry",
   "Volume": "NodeSocketObject",
   "Width": "NodeSocketFloat",
   "Height": "NodeSocketFloat",

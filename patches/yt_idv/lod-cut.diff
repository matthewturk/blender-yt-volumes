diff --git a/yt_idv/tests/test_kd_walk.py b/yt_idv/tests/test_kd_walk.py
new file mode 100644
index 0000000..4fa338a
--- /dev/null
+++ b/yt_idv/tests/test_kd_walk.py
@@ -0,0 +1,142 @@
+import numpy as np
+import pytest
+import yt.testing
+
+from yt_idv.scene_data.block_collection import _flatten_kd_tree, _kd_viewpoint_order
+from yt_idv.utilities.kd_walk import viewpoint_order
+
+VIEWPOINTS = np.random.default_rng(0).uniform(-1.0, 2.0, size=(12, 3))
+
+
+@pytest.fixture(scope="module")
+def tree():
+    ds = yt.testing.fake_amr_ds()
+    trunk = ds.all_data().tiles.tree.trunk
+    kd = _flatten_kd_tree(trunk)
+    # node boxes, row for row with _flatten_kd_tree's arrays (which repeat a
+    # node at each position depth_traverse yields it)
+    nodes = list(trunk.depth_traverse())
+    bounds = np.array([[*n.get_left_edge(), *n.get_right_edge()] for n in nodes])
+    return kd, bounds
+
+
+def _walk(kd, viewpoint, nearest_first=False, **lod):
+    order = np.full(len(kd["left"]), -1, dtype="int64")
+    n = viewpoint_order(
+        kd["left"],
+        kd["right"],
+        kd["split_dim"],
+        kd["split_pos"],
+        kd["block"],
+        np.asarray(viewpoint, dtype="f8"),
+        order,
+        nearest_first,
+        **lod,
+    )
+    return order[:n].tolist()
+
+
+@pytest.mark.parametrize("nearest_first", [False, True])
+def test_matches_python_walk(tree, nearest_first):
+    kd, bounds = tree
+    lod_block = np.arange(len(kd["left"]), dtype="int64") + 10_000
+    for viewpoint in VIEWPOINTS:
+        expected = _kd_viewpoint_order(kd, viewpoint)
+        if nearest_first:
+            expected = expected[::-1]
+        assert _walk(kd, viewpoint, nearest_first) == expected
+        # coarse data given but no angle: no cut
+        assert (
+            _walk(
+                kd,
+                viewpoint,
+                nearest_first,
+                lod_block=lod_block,
+                lod_bounds=bounds,
+                max_angle=0.0,
+            )
+            == expected
+        )
+
+
+def _collapsed(kd, bounds, lod_block, viewpoint, max_angle, nearest_first):
+    # the full order, with the leaves under each node the walk stops at (the
+    # topmost ancestor small enough from the viewpoint) replaced by its block
+    left, right = kd["left"], kd["right"]
+    parent = np.full(len(left), -1)
+    for i in np.flatnonzero(left != -1):
+        parent[left[i]] = parent[right[i]] = i
+    leaf_of = {b: i for i, b in enumerate(kd["block"]) if b != -1 and left[i] == -1}
+
+    def cut_node(leaf):
+        path = []
+        i = parent[leaf]
+        while i != -1:
+            path.append(i)
+            i = parent[i]
+        for i in reversed(path):
+            if lod_block[i] == -1:
+                continue
+            lo, hi = bounds[i, :3], bounds[i, 3:]
+            distance = np.linalg.norm(np.maximum(np.maximum(lo - viewpoint, viewpoint - hi), 0))
+            if distance > 0 and np.linalg.norm(hi - lo) < max_angle * distance:
+                return i
+        return -1
+
+    order = _kd_viewpoint_order(kd, viewpoint)
+    if nearest_first:
+        order = order[::-1]
+    out = []
+    for b in order:
+        node = cut_node(leaf_of[b])
+        entry = b if node == -1 else int(lod_block[node])
+        if node == -1 or not out or out[-1] != entry:
+            out.append(entry)
+    return out
+
+
+@pytest.mark.parametrize("nearest_first", [False, True])
+@pytest.mark.parametrize("max_angle", [0.05, 0.3, 1.0, 10.0])
+def test_cut_collapses_subtrees(tree, nearest_first, max_angle):
+    kd, bounds = tree
+    interior = np.flatnonzero(kd["left"] != -1)
+    rng = np.random.default_rng(1)
+    lod_block = np.full(len(kd["left"]), -1, dtype="int64")
+    with_data = rng.choice(interior, size=len(interior) // 2, replace=False)
+    lod_block[with_data] = 10_000 + with_data
+    cuts = 0
+    for viewpoint in VIEWPOINTS:
+        got = _walk(
+            kd,
+            viewpoint,
+            nearest_first,
+            lod_block=lod_block,
+            lod_bounds=bounds,
+            max_angle=max_angle,
+        )
+        expected = _collapsed(kd, bounds, lod_block, viewpoint, max_angle, nearest_first)
+        assert got == expected
+        assert len(set(got)) == len(got)
+        cuts += sum(b >= 10_000 for b in got)
+    if max_angle >= 1.0:
+        assert cuts > 0
+
+
+def test_box_holding_viewpoint_is_not_cut(tree):
+    kd, bounds = tree
+    inside = np.array([0.3, 0.6, 0.45])
+    lo, hi = bounds[:, :3], bounds[:, 3:]
+    holding = np.flatnonzero(
+        (kd["left"] != -1)
+        & np.all(np.isfinite(bounds), axis=1)
+        & np.all((lo < inside) & (inside < hi), axis=1)
+    )
+    # the rows the walk reaches (the others repeat a node at an earlier position)
+    reached = np.union1d(kd["left"], kd["right"])
+    node = np.intersect1d(holding, reached)[-1]
+    lod_block = np.full(len(kd["left"]), -1, dtype="int64")
+    lod_block[node] = 99_999
+    lod = {"lod_block": lod_block, "lod_bounds": bounds, "max_angle": 1e9}
+    assert 99_999 not in _walk(kd, inside, **lod)
+    # from far away the same node is cut
+    assert 99_999 in _walk(kd, inside + 1e3, **lod)

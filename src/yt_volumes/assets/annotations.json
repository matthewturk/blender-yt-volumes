   "Text Color": "NodeSocketColor",
   "Show Opacity": "NodeSocketBool",
   "Opacity Height": "NodeSocketFloat",
   "Opacity Decades": "NodeSocketFloat",
   "Line Width": "NodeSocketFloat"
  }
 },
 {
  "name": "yt Field of View",
  "scene": "ANNOTATION",
  "description": "A labeled scale bar, sized at the volume's zoom target or middle",
  "inputs": {
   "Geometry": "NodeSocketGeometry",
   "Units Object": "NodeSocketObject",
   "Unit": "NodeSocketString",

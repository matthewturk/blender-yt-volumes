index 0000000..6d4c246
--- /dev/null
+++ b/yt_idv/tests/test_lod.py
@@ -0,0 +1,114 @@
+import numpy as np
+import pytest
+from yt.testing import fake_amr_ds
+
+from yt_idv.scene_graph import SceneGraph
+from yt_idv.standalone_export import export_block_scene
+
+LEFT, RIGHT = [0.25, 0.3, 0.35], [0.65, 0.7, 0.75]
+
+
+@pytest.fixture(scope="module")
+def scene_files(tmp_path_factory):
+    ds = fake_amr_ds()
+    region = ds.region([0.5, 0.5, 0.5], LEFT, RIGHT)
+    path = tmp_path_factory.mktemp("lod")
+    plain, lod = path / "plain.zip", path / "lod.zip"
+    export_block_scene(region, "Density", plain, no_ghost=True)
+    export_block_scene(region, "Density", lod, no_ghost=True, interior_nodes=True)
+    return plain, lod
+
+
+@pytest.fixture()
+def rc(make_rc):
+    return make_rc(width=64, height=64)
+
+
+def _rows(data, name="in_left_edge"):
+    return len(data.vertex_array[name].data)
+
+
+def _render(rc, scene, method, position=(1.5, 1.2, 2.0), lod_pixels=0.0):
+    rc.scene = scene
+    component = scene.components[0]
+    component.render_method = method
+    component.lod_pixels = lod_pixels
+    scene.camera.update(
+        position=list(position),
+        focus=[0.5, 0.5, 0.5],
+        up=[0.0, 0.0, 1.0],
+        fov=45.0,
+        near_plane=1e-3,
+        far_plane=20.0,
+        aspect_ratio=1.0,
+    )
+    # the first frame can differ, as some components leave GL state behind
+    rc.run()
+    return np.array(rc.run())
+
+
+def test_coarse_blocks_follow_the_leaves(rc, scene_files):
+    plain, lod = scene_files
+    leaves = SceneGraph.load(plain).components[0].data
+    data = SceneGraph.load(lod).components[0].data
+    n_leaves = len(leaves.block_data)
+    n_coarse = len(data._lod_data)
+    assert n_coarse > 0
+    assert len(data.block_data) == n_leaves
+    assert _rows(data) == _rows(data, "model_vertex") == n_leaves + n_coarse
+    assert len(data.data_atlas) == len(data.bitmap_atlas) == n_leaves + n_coarse
+    blocks = data._lod_block[data._lod_block != -1]
+    assert set(blocks) == set(range(n_leaves, n_leaves + n_coarse))
+
+
+@pytest.mark.parametrize("method", ["max_intensity", "transfer_function"])
+def test_unchanged_without_a_cut(rc, scene_files, method):
+    plain, lod = scene_files
+    expected = _render(rc, SceneGraph.load(plain), method)
+    image = _render(rc, SceneGraph.load(lod), method)
+    assert np.any(expected != 0)
+    # the coarse blocks change the atlas layout, and with it the rounding of
+    # texture coordinates: at most one 8-bit level
+    assert np.abs(image - expected).max() <= 1 / 255 + 1e-6
+
+
+@pytest.mark.parametrize("method", ["max_intensity", "transfer_function"])
+def test_cut_draws_coarse_blocks(rc, scene_files, method):
+    _, lod = scene_files
+    scene = SceneGraph.load(lod)
+    data = scene.components[0].data
+    far = (4.0, 3.4, 5.0)
+    image = _render(rc, scene, method, position=far, lod_pixels=64.0)
+    angle = scene.components[0]._lod_max_angle(scene.camera)
+    assert angle > 0
+    order = data.viewpoint_order(scene.camera, nearest_first=True, max_angle=angle)
+    n_leaves = len(data.block_data)
+    assert np.any(order >= n_leaves)
+    assert len(order) < n_leaves
+    assert np.all(np.isfinite(image)) and np.any(image != 0)
+
+
+def test_saved_scene_leaves_out_coarse_blocks(rc, scene_files, tmp_path):
+    plain, lod = scene_files
+    scene = SceneGraph.load(lod)
+    data = scene.components[0].data
+    rows = _rows(data)
+    scene.save(tmp_path / "resaved.zip")
+    # the scene in memory keeps them
+    assert _rows(data) == rows
+    resaved = SceneGraph.load(tmp_path / "resaved.zip").components[0].data
+    assert resaved._lod_block is None
+    assert _rows(resaved) == len(resaved.block_data) == len(data.block_data)
+
+
+def test_rescale_moves_coarse_blocks(rc, scene_files):
+    _, lod = scene_files
+    data = SceneGraph.load(lod).components[0].data
+    data.apply_scale((0.1, 0.2, 0.3), 2.0)
+    n = len(data.block_data)
+    offset = np.asarray(data.applied_scale_offset)
+    ratio = data.applied_scale_ratio
+    left = data.vertex_array["in_left_edge"].data[n:]
+    dx = data.vertex_array["in_dx"].data[n:]
+    np.testing.assert_allclose(left, (data._lod_edges[0] - offset) / ratio)
+    np.testing.assert_allclose(dx, data._lod_edges[2] / ratio)
